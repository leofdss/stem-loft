# StemLoft development image for use with Distrobox (runtime: Podman).
#
# Base: quay.io/toolbx/arch-toolbox -- an Arch image maintained by the
# Toolbx project (Distrobox's sibling, same family of tools), already
# comes with base-devel (gcc, make, pkgconf, ...), git, and sudo ready.
#
# Golden rule of this Containerfile: NOTHING is installed inside /home.
# Distrobox mounts the host's HOME over the container's HOME -- anything
# written to /home/<user> during the build becomes invisible at runtime
# (or worse, silently overwritten). Every package/tool below goes to
# system paths (/usr, /opt), which survive the HOME overlay.
#
# git and Claude Code authentication (~/.gitconfig, ~/.claude, etc.) need
# no special handling here: since they already live in HOME, they're
# automatically shared with the host through Distrobox's default behavior
# -- logging in once on the host keeps working inside the container, even
# after recreating it.
FROM quay.io/toolbx/arch-toolbox:latest

LABEL org.opencontainers.image.title="stemloft-dev" \
      org.opencontainers.image.description="Development environment (Arch Linux) for StemLoft, for use with Distrobox/Podman" \
      org.opencontainers.image.licenses="GPL-3.0-or-later"

# This base image doesn't ship with the pacman local signing master key
# generated -- without it, the archlinux-keyring sync hook fails trying to
# validate signatures ("no secret key available to sign with") during the
# -Syu below. --init is safe to run again if the base image ever starts
# shipping this ready to go.
RUN pacman-key --init && pacman-key --populate archlinux

# Mirrors + repos updated before any install, and --needed on every pacman
# call to make the build idempotent across rebuilds.
RUN pacman -Syu --noconfirm --needed \
    # Version control
    git \
    # Python -- used by the hooks in .claude/hooks (standard library only)
    python \
    # Node.js -- an always-ready "system" runtime
    # (fnm, below, covers per-project version pinning when needed)
    nodejs \
    npm \
    fnm \
    # Rust -- stable toolchain via the official package (not rustup: rustup
    # lives in $HOME/.cargo and would be hidden by Distrobox's HOME overlay).
    # Arch is a rolling release, so "pacman -Syu" already keeps this on the
    # latest stable version, the same philosophy the project already
    # applies to Tauri/Angular (see docs/architecture.md#stack-and-platform).
    rust \
    # Tauri v2 Linux build dependencies (Tauri's official list for Arch:
    # https://v2.tauri.app/start/prerequisites/)
    webkit2gtk-4.1 \
    curl \
    wget \
    file \
    openssl \
    appmenu-gtk-module \
    gtk3 \
    libappindicator-gtk3 \
    librsvg \
    patchelf \
    # Audio output (cpal/ALSA) used by the Audio Engine at build time
    alsa-lib \
    # sudo already ships in the Toolbx base image, but it's the mechanism
    # Distrobox uses to grant the host user privileges inside the
    # container -- kept explicit here so this doesn't depend on the base
    # image's package composition.
    sudo \
    # VS Code (Electron) needs libsecret (the credential keyring) and
    # NSS/NSPR (libnss3/libnspr4, loaded at runtime)
    libsecret \
    nss \
 && pacman -Scc --noconfirm \
 && rm -rf /var/cache/pacman/pkg/* /var/lib/pacman/sync/*

# Claude Code (CLI) -- no official package in the Arch repos. Installed via
# npm global as root, so it lands in /usr/lib/node_modules and
# /usr/bin/claude (the system npm prefix), never in HOME.
# --allow-scripts is required: recent npm blocks the package's postinstall
# script (which downloads the CLI's native binary) by default; without it,
# `claude` gets installed but doesn't work ("native binary not installed").
RUN npm install --global --allow-scripts=@anthropic-ai/claude-code @anthropic-ai/claude-code \
 && npm cache clean --force

# VS Code -- also has no official package in the Arch repos (only via AUR,
# which depends on third-party build/maintenance). To keep the "works long
# term" promise in an auditable way, we install the official tarball
# published by Microsoft itself, extracted to /opt (outside HOME) with a
# symlink in /usr/local/bin.
RUN curl -fsSL "https://update.code.visualstudio.com/latest/linux-x64/stable" -o /tmp/vscode.tar.gz \
 && mkdir -p /opt/vscode \
 && tar -xzf /tmp/vscode.tar.gz -C /opt/vscode --strip-components=1 \
 && rm -f /tmp/vscode.tar.gz \
 && ln -s /opt/vscode/bin/code /usr/local/bin/code

# The VS Code binary detects that it's running under WSL (common on this
# project's host) and blocks on an interactive "Do you want to continue
# anyway? [y/N]" prompt suggesting the Windows-side VS Code via Remote-WSL
# instead. Without this variable, `code` hangs waiting on stdin instead of
# running.
ENV DONT_PROMPT_WSL_INSTALL=1

# No USER/HOME is set here on purpose: Distrobox creates the user (same
# UID/GID/name as the host), mounts the host's HOME, and sets up sudo when
# the container is created -- not at image build time.
