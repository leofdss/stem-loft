{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StemLoft",
  "version": "0.1.0",
  "identifier": "io.github.leofdss.stemloft",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui start -- --port 4200",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "devUrl": "http://localhost:4200",
    "frontendDist": "../ui/dist/stemloft/browser"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "StemLoft",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
